# Supabase PostgreSQL baglanti dizesi
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Session Pooler - Port 5432)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[SIFRENIZ]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=public"

# Guvenlik ve sunucu ayarlari
JWT_SECRET="en-az-32-karakterlik-rastgele-bir-deger"
JWT_EXPIRES_IN="30d"
HOST="0.0.0.0"
PORT=3000

# Web arayüzü / e-posta bağlantı adresi
APP_URL="http://localhost:8080"

# E-posta gonderimi (SMTP tanimli degilse gelistirmede konsola ve Ethereal test onizlemesine duser)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="user@example.com"
# SMTP_PASS="secret"
# SMTP_FROM="Halka <noreply@halka.app>"
# SMTP_SECURE=false

# Supabase Auth e-posta entegrasyonu (isteğe bağlı)
# SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# SUPABASE_ANON_KEY="eyJhbGciOi..."

